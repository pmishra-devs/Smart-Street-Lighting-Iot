
#include <WiFi.h>
#include <WebServer.h>

// Pin Configuration
const int LDR_PIN = 0;
const int IR_PIN[3] = {1, 3, 4};
const int LAMP_PIN[5] = {5, 6, 7, 10, 20};
const int LAMP_ZONE[5] = {0, 0, 1, 2, 2};

// System Settings
const int NIGHT_BELOW = 1200;
const int DAY_ABOVE = 1600;
const int DIM_LEVEL = 40;
const int FULL_LEVEL = 255;

const unsigned long HOLD_MS = 3000;
const int FADE_STEP = 5;

// WiFi Credentials
const char *WIFI_NAME = "SmartStreetLight";
const char *WIFI_PASS = "streetlight123";

// System Variables
WebServer server(80);

bool isNight = false;
int ldrValue = 0;

bool carSeen[3] = {false, false, false};
unsigned long lastSeen[3] = {0, 0, 0};

int brightness[5] = {0, 0, 0, 0, 0};

double energyUsed = 0;
double energyFull = 0;

// IR Sensor Detection
bool irDetects(int i) {
  return digitalRead(IR_PIN[i]) == LOW;
}

// Read Sensors
void readSensors() {
  long sum = 0;

  for (int k = 0; k < 8; k++) {
    sum += analogRead(LDR_PIN);
  }

  ldrValue = sum / 8;

  if (!isNight && ldrValue < NIGHT_BELOW)
    isNight = true;

  if (isNight && ldrValue > DAY_ABOVE)
    isNight = false;

  for (int i = 0; i < 3; i++) {
    carSeen[i] = irDetects(i);

    if (carSeen[i]) {
      lastSeen[i] = millis();
    }
  }
}

// Calculate Target Brightness
int targetFor(int lamp) {
  if (!isNight) return 0;

  int zone = LAMP_ZONE[lamp];

  bool recentCar =
    lastSeen[zone] != 0 &&
    millis() - lastSeen[zone] < HOLD_MS;

  return recentCar ? FULL_LEVEL : DIM_LEVEL;
}

// Update Streetlights
void updateLamps() {
  for (int i = 0; i < 5; i++) {
    int target = targetFor(i);

    if (brightness[i] < target)
      brightness[i] = min(brightness[i] + FADE_STEP, target);

    if (brightness[i] > target)
      brightness[i] = max(brightness[i] - FADE_STEP, target);

    analogWrite(LAMP_PIN[i], brightness[i]);

    if (isNight) {
      energyUsed += brightness[i];
      energyFull += FULL_LEVEL;
    }
  }
}

// Calculate Estimated Energy Savings
int energySavedPercent() {
  if (energyFull == 0) return 0;

  return (int)(
    100.0 * (1.0 - energyUsed / energyFull) + 0.5
  );
}

