// Main Dashboard
void handleRoot() {
  server.send_P(200, "text/html", PAGE);
}

// Send Live Sensor Data
void handleData() {
  String j = "{\"night\":";

  j += isNight ? "true" : "false";
  j += ",\"ldr\":" + String(ldrValue);
  j += ",\"saved\":" + String(energySavedPercent());

  j += ",\"lamps\":[";

  for (int i = 0; i < 5; i++) {
    j += String(brightness[i]);
    j += (i < 4 ? "," : "");
  }

  j += "],\"ir\":[";

  for (int i = 0; i < 3; i++) {
    j += String(carSeen[i] ? 1 : 0);
    j += (i < 2 ? "," : "");
  }

  j += "]}";

  server.send(200, "application/json", j);
}

// Setup
void setup() {
  Serial.begin(115200);
  delay(500);

  analogReadResolution(12);

  for (int i = 0; i < 3; i++) {
    pinMode(IR_PIN[i], INPUT);
  }

  for (int i = 0; i < 5; i++) {
    pinMode(LAMP_PIN[i], OUTPUT);
    analogWrite(LAMP_PIN[i], 0);
  }

  WiFi.softAP(WIFI_NAME, WIFI_PASS);

  server.on("/", handleRoot);
  server.on("/data", handleData);

  server.begin();

  Serial.println("Smart Street Lighting started");

  Serial.print("Wi-Fi: ");
  Serial.print(WIFI_NAME);

  Serial.print(" Open http://");
  Serial.println(WiFi.softAPIP());
}

// Main Loop
void loop() {
  static unsigned long lastFade = 0;
  static unsigned long lastPrint = 0;

  server.handleClient();

  readSensors();

  if (millis() - lastFade >= 10) {
    lastFade = millis();
    updateLamps();
  }

  if (millis() - lastPrint >= 1000) {
    lastPrint = millis();

    Serial.printf(
      "LDR=%4d %s IR=%d%d%d lamps=%3d %3d %3d %3d %3d saved=%d%%\n",
      ldrValue,
      isNight ? "NIGHT" : "DAY",
      carSeen[0], carSeen[1], carSeen[2],
      brightness[0], brightness[1],
      brightness[2], brightness[3], brightness[4],
      energySavedPercent()
    );
  }
}
